{
  "name": "recycle-buddy-backend",
  "version": "1.0.0",
  "description": "Backend for Recycle Buddy using OpenRouter and Gemini",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@openrouter/sdk": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "heic-convert": "^2.1.0",
    "multer": "^1.4.5-lts.1",
    "firebase-functions": "^6.0.0",
    "firebase-admin": "^13.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "type": "module",
    "testEnvironment": "node",
    "transform": {},
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": [
      "routes/**/*.js",
      "services/**/*.js",
      "!**/node_modules/**"
    ] 
  }
}
